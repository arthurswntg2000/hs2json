cabal-version:      2.4
name:               hs2json
version:            0.1.0.0
synopsis:           Biblioteca JSON, Pretty Printer e Testes com QuickCheck em Haskell
author:             Arthur Sampaio Pereira e Andre Moura Lima
build-type:         Simple

library
    exposed-modules:  SimpleJSON
                    , Prettify
                    , PrettyJSON
    build-depends:    base >= 4.14 && < 5
    hs-source-dirs:   src
    default-language: Haskell2010

executable hs2json
    main-is:          Main.hs
    build-depends:    base >= 4.14 && < 5
                    , hs2json
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite hs2json-tests
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >= 4.14 && < 5
                    , hs2json
                    , QuickCheck >= 2.14
    default-language: Haskell2010