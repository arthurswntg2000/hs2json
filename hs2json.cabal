cabal-version:      3.0
name:               hs2json
version:            0.1.0.0
synopsis:           Biblioteca JSON, pretty printer e testes com QuickCheck em Haskell
description:        Uma pequena biblioteca de pretty printing que ilustra
                    como desenvolver uma biblioteca Haskell, com suporte a JSON.
category:           Text
license:            BSD-3-Clause
author:             Arthur Sampaio Pereira e Andre Moura Lima
maintainer:         seu@email.org
build-type:         Simple

library
    exposed-modules:  SimpleJSON
                    , Prettify
                    , PrettyJSON
                    , QuickTestes
    build-depends:    base >= 4.14 && < 5
                    , QuickCheck >= 2.14
    hs-source-dirs:   src
    default-language: Haskell2010

executable hs2json-exe
    main-is:          Main.hs
    build-depends:    base >= 4.14 && < 5
                    , hs2json
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite hs2json-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >= 4.14 && < 5
                    , hs2json
                    , QuickCheck >= 2.14
    default-language: Haskell2010